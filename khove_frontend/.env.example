# ─────────────────────────────────────────────
# Khove frontend (Next.js) — Environment Variables
# Copy to .env.local and fill in all values.
#
# The frontend holds only PUBLIC keys + the Clerk secret (used by Next
# middleware + RSC auth().getToken()) + the backend URLs. Every other secret
# lives in khove_backend/.env.local.
# ─────────────────────────────────────────────

# ── Backend (Express) endpoints ──
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ── Clerk — https://clerk.com ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...        # Next middleware + RSC token minting
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/join
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
