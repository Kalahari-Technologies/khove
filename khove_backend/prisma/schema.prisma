generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum PlanTier {
  FREE
  PRO
  TEAM
  SMB
  ENTERPRISE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TaskSource {
  KHOVE
  GITHUB
  JIRA
  AI
  GOOGLE_CALENDAR
}

enum AssigneeRole {
  OWNER
  ASSIGNEE
  REVIEWER
  OBSERVER
}

// AI always works with categories, never status name strings directly.
enum StatusCategory {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  USER
  URL
  CHECKBOX
}

enum IntegrationProvider {
  GITHUB
  GOOGLE_CALENDAR
  JIRA
}

enum BillingProvider {
  STRIPE
  PAYSTACK
  FLUTTERWAVE
}

enum SubStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

// Connectivity Thread — one work item spanning Calendar / GitHub / people.
enum ThreadStatus {
  OPEN
  ACTIVE
  RESOLVED
  ARCHIVED
}

enum ThreadLinkKind {
  TASK
  CALENDAR_EVENT
  GITHUB_PR
  GITHUB_ISSUE
  PERSON
  JIRA_ISSUE
}

// Approval-gated proactive agent actions.
enum AgentActionType {
  BLOCK_FOCUS_TIME
  RESCHEDULE_EVENT
  RSVP_NUDGE
  CREATE_EVENT
  SUGGEST_THREAD
}

enum AgentActionStatus {
  PENDING
  APPROVED
  EXECUTED
  REJECTED
  FAILED
  EXPIRED
  DISMISSED
}

// ─────────────────────────────────────────────
// Core Tables
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  planTier  PlanTier @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMember  WorkspaceMember[]
  tasks            Task[]
  taskAssignees    TaskAssignee[]    @relation("AssignedUser")
  assignedBy       TaskAssignee[]    @relation("AssignedBy")
  integrations     Integration[]
  conversations    Conversation[]
  aiUsageLogs      AiUsageLog[]
  subscriptions    Subscription[]
  calendarEntries  CalendarEntry[]
}

model Workspace {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  isPersonal Boolean  @default(false)
  gradient   String   @default("slate")
  ownerId    String
  planTier   PlanTier @default(FREE)
  settings   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  owner             User                    @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members           WorkspaceMember[]
  tasks             Task[]
  workflowStatuses  WorkflowStatus[]
  customFields      CustomFieldDefinition[]
  integrations      Integration[]
  calendarEntries   CalendarEntry[]
  conversations     Conversation[]
  aiUsageLogs       AiUsageLog[]
  subscriptions     Subscription[]
  threads           Thread[]
  agentActions      AgentAction[]
  auditLogs         AuditLog[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  statusId    String?
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  source      TaskSource[] @default([KHOVE])
  externalId  String?
  externalUrl String?
  description String?
  metadata    Json?
  userId      String
  workspaceId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  user        User           @relation(fields: [userId], references: [id])
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id])
  status      WorkflowStatus? @relation(fields: [statusId], references: [id])
  assignees   TaskAssignee[]
  fieldValues TaskFieldValue[]

  @@index([userId])
  @@index([workspaceId])
  @@index([source])
  @@index([externalId])
}

// Multi-assignee junction table — never a single assigneeId on Task
model TaskAssignee {
  taskId     String
  userId     String
  role       AssigneeRole @default(ASSIGNEE)
  assignedBy String?
  assignedAt DateTime     @default(now())

  task           Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User  @relation("AssignedUser", fields: [userId], references: [id])
  assignedByUser User? @relation("AssignedBy", fields: [assignedBy], references: [id])

  @@unique([taskId, userId])
  @@index([userId])
}

// Flexible workflow statuses — null workspaceId = global system default
model WorkflowStatus {
  id          String         @id @default(cuid())
  name        String
  color       String         @default("#71717A")
  category    StatusCategory
  position    Int            @default(0)
  isDefault   Boolean        @default(false)
  isSystem    Boolean        @default(false)
  workspaceId String?
  source      String?
  externalId  String?

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  tasks     Task[]

  @@index([workspaceId])
  @@index([category])
}

model CustomFieldDefinition {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  fieldType   FieldType @default(TEXT)
  options     Json      @default("[]")
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fieldValues TaskFieldValue[]

  @@index([workspaceId])
}

model TaskFieldValue {
  taskId   String
  fieldId  String
  value    String

  task  Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([taskId, fieldId])
}

// OAuth tokens always encrypted — NEVER store plaintext
// Workspace-scoped: each workspace independently connects its own integrations.
// userId tracks WHO connected it (for token refresh); workspaceId is the primary lookup key.
model Integration {
  id               String              @id @default(cuid())
  provider         IntegrationProvider
  userId           String              // who connected it
  workspaceId      String              // which workspace owns it
  accessTokenEnc   String              // AES-256-GCM encrypted via lib/encryption.ts
  refreshTokenEnc  String?
  tokenExpiresAt   DateTime?
  metadata         Json                @default("{}")
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([provider, workspaceId])  // one connection per provider per workspace
  @@index([userId])
  @@index([workspaceId])
  @@index([userId, provider])
}

// Conversation history as JSON — pruned at 40 messages
model Conversation {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  messages    Json     @default("[]") // Array of { role, content, timestamp }
  summary     String?
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([workspaceId])
}

model AiUsageLog {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  model       String
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  costUsd     Float    @default(0)
  feature     String?
  timestamp   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([timestamp])
}

// billingProvider NEVER exposed to client — frontend sees tier + status only
model Subscription {
  id                String          @id @default(cuid())
  userId            String?
  workspaceId       String?
  billingProvider   BillingProvider @default(STRIPE)
  externalCustomerId String?
  externalSubId     String?
  tier              PlanTier        @default(FREE)
  status            SubStatus       @default(ACTIVE)
  currency          String          @default("USD")
  trialEnd          DateTime?
  currentPeriodEnd  DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user      User?      @relation(fields: [userId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([externalSubId])
}

// External/inconsequential calendar events — display only, no sync
model CalendarEntry {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  title       String
  startDate   DateTime
  endDate     DateTime?
  isAllDay    Boolean   @default(false)
  externalId  String?
  source      String    @default("GOOGLE_CALENDAR")
  metadata    Json?
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, externalId])
  @@index([userId])
  @@index([workspaceId])
  @@index([startDate])
}

// ─────────────────────────────────────────────
// Connectivity Thread — the V4 core primitive
// ─────────────────────────────────────────────

// One work item spanning Calendar / GitHub / people. Never auto-created — formed
// manually or by approving a SUGGEST_THREAD agent action; links are attached after.
model Thread {
  id          String       @id @default(cuid())
  workspaceId String
  title       String
  summary     String?
  status      ThreadStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  links     ThreadLink[]

  @@index([workspaceId, status])
}

model ThreadLink {
  id        String         @id @default(cuid())
  threadId  String
  kind      ThreadLinkKind
  refId     String // Task.id | Google eventId | User.id | attendee email | github externalId
  refUrl    String?
  title     String?
  metadata  Json           @default("{}")
  createdAt DateTime       @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, kind, refId])
  @@index([threadId])
  @@index([kind, refId])
}

// ─────────────────────────────────────────────
// Agent actions + audit (governance: read auto / write approval / delete explicit)
// ─────────────────────────────────────────────

// A proactive action the agent proposes; PENDING until a human approves, then
// executed and audited. Write-action execution is plan-gated (PRO+).
model AgentAction {
  id          String            @id @default(cuid())
  workspaceId String
  threadId    String?
  type        AgentActionType
  status      AgentActionStatus @default(PENDING)
  title       String
  rationale   String
  confidence  Float?
  sources     Json              @default("[]")
  payload     Json              @default("{}")
  dedupeKey   String
  proposedBy  String // "agent:calendar-intelligence" | userId
  approvedBy  String?
  approvedAt  DateTime?
  executedAt  DateTime?
  error       String?
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorType   String // USER | AGENT
  actorId     String
  action      String // "agent_action.approved" | "calendar.event.deleted" | ...
  targetType  String?
  targetId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
