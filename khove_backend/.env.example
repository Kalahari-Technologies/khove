# ─────────────────────────────────────────────
# Khove backend (Express) — Environment Variables
# Copy to .env.local and fill in all values.
#
# The backend owns every SECRET. The frontend (khove_frontend) keeps only
# NEXT_PUBLIC_* + the Clerk publishable key + NEXT_PUBLIC_BACKEND_URL/WS_URL.
# ─────────────────────────────────────────────

# ── Server ──
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000      # CORS origin + OAuth/email redirect target
BACKEND_URL=http://localhost:4000          # OAuth callback + webhook base URL

# ── Clerk — https://clerk.com ──
# @clerk/express needs BOTH the secret and the publishable key.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ── Database — Supabase PostgreSQL ──
# DATABASE_URL = Transaction pooler; DIRECT_URL = Session (direct) for migrations.
DATABASE_URL=postgresql://postgres....
DIRECT_URL=postgresql://....

# ── Redis — Upstash ──
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Encryption — generate with: openssl rand -hex 32 ──
ENCRYPTION_KEY=...64-hex-chars...

# ── AI ──
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# ── Email — Resend ──
RESEND_API_KEY=re_...

# ── Inngest ──
# Local dev: run `npm run inngest` (CLI dev server) and leave the signing/event
# keys UNSET (set INNGEST_DEV=1). Set these only in staging/production.
INNGEST_DEV=1
# INNGEST_EVENT_KEY=...
# INNGEST_SIGNING_KEY=signkey-...

# ── GitHub App ──
GITHUB_APP_ID=...
# The App's URL slug — github.com/apps/<slug> — used to build the install URL.
GITHUB_APP_SLUG=khove
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET=...
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
# GitHub OAuth callback (register in the GitHub App):
#   ${BACKEND_URL}/api/integrations/github/callback
# Enable "Request user authorization (OAuth) during installation" on the App so the
# callback receives BOTH `code` and `installation_id`. Subscribe to events:
#   Pull request, Pull request review, Check suite/run (or Status), Issues, Installation.

# ── Google OAuth (Calendar) ──
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Callback is hosted on the BACKEND origin now (register this exact URI in GCP):
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# ── Atlassian OAuth 2.0 (Jira Cloud, 3LO) — https://developer.atlassian.com ──
# From the app's Settings → Authentication details. Permissions → Jira API scopes:
#   read:jira-work, write:jira-work, read:jira-user, manage:jira-webhook
# (offline_access is requested at connect time for refresh tokens.)
# cloudId is resolved at runtime from the accessible-resources endpoint.
ATLASSIAN_CLIENT_ID=...
ATLASSIAN_CLIENT_SECRET=...
# OAuth callback — register under the app's Authorization (OAuth 2.0 3LO):
#   ${BACKEND_URL}/api/integrations/jira/callback
# Dynamic webhook receiver (registered via REST at connect, refreshed <30 days):
#   ${BACKEND_URL}/api/webhooks/jira
