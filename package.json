{
  "name": "khove",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "khove_frontend",
    "khove_backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w khove_backend & npm run dev -w khove_frontend",
    "dev:frontend": "npm run dev -w khove_frontend",
    "dev:backend": "npm run dev -w khove_backend",
    "inngest": "npm run inngest -w khove_backend",
    "build": "npm run build -w khove_backend && npm run build -w khove_frontend",
    "typecheck": "npm run typecheck -w @khove/shared && npm run typecheck -w khove_backend && npm run typecheck -w khove_frontend",
    "db:generate": "npm run db:generate -w khove_backend",
    "db:migrate": "npm run db:migrate -w khove_backend",
    "db:push": "npm run db:push -w khove_backend",
    "db:clear": "npm run db:clear -w khove_backend",
    "db:seed": "npm run db:seed -w khove_backend",
    "db:studio": "npm run db:studio -w khove_backend"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  }
}
